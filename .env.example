# 复制为 .env 后在服务器上填写；.env 不入库、不进参赛代码包
LLM_BASE_URL=https://tokenone.work/v1
LLM_API_KEY=__在服务器上填写，勿提交__
LLM_MODEL_FAST=qwen3.8-flash
LLM_MODEL_STRONG=qwen3.8-max
EMBED_MODEL=__实测后填写__
EMBED_DIM=__实测后填写__
DB_PASSWORD=__随机生成__
JWT_SECRET=__随机生成__
CHILD_KEY=__随机生成，用于幼儿姓名加密，丢失后无法解密__
REVIEW_CONFIDENCE_THRESHOLD=0.7
DEBATE_MAX_ROUNDS=2
FORCE_REVIEW_CATEGORIES=安全,卫生,健康
